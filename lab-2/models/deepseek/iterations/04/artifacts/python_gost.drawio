  <diagram id="python-gost-page" name="Python ГОСТ">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="n1" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="n2" value="Ввести количество вершин vertex_count" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n3" value="Ввести матрицу смежности matrix" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n4" value="Ввести start, finish" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n5" value="0 &lt;= start &lt; vertex_count и&lt;br&gt;0 &lt;= finish &lt; vertex_count?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="390" width="230" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="n6" value="Вывести &quot;Invalid vertices&quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="650" y="410" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n7" value="distance = [inf] * vertex_count&lt;br&gt;previous = [-1] * vertex_count&lt;br&gt;visited = [False] * vertex_count&lt;br&gt;distance[start] = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="530" width="290" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n8" value="Начало внешнего цикла:&lt;br&gt;шаг = 0 .. vertex_count - 1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="660" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n9" value="Выбрать непосещённую вершину current&lt;br&gt;с минимальным distance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="790" width="290" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="n10" value="current == -1 или&lt;br&gt;distance[current] == inf?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="900" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n11" value="current == finish?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="1030" width="230" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="n12" value="visited[current] = True" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="1150" width="290" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="n13" value="Перебрать соседей neighbor:&lt;br&gt;weight = matrix[current][neighbor]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="1240" width="290" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="n14" value="weight &gt; 0 и not visited[neighbor]?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="1350" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n15" value="candidate = distance[current] + weight&lt;br&gt;candidate &lt; distance[neighbor]?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="1480" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n16" value="distance[neighbor] = candidate&lt;br&gt;previous[neighbor] = current" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="1610" width="290" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="n17" value="distance[finish] == inf?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="1720" width="230" height="80" as="geometry"/>
        </mxCell>

