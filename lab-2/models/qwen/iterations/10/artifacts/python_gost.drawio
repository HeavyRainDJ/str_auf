        </mxCell>
        
        <mxCell id="9" value="current == -1 или&#10;distance[current] == inf или&#10;current == finish?" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
