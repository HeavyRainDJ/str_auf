        </mxCell>
        
        <mxCell id="12" value="candidate =&#10;distance[current] + weight" style="shape=rectangle;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
