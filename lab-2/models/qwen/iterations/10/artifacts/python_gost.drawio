        <mxCell id="7" value="distance = [inf]*V&#10;previous = [-1]*V&#10;visited = [False]*V&#10;distance[start] = 0" style="shape=rectangle;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
